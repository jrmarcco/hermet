@uri = http://localhost:8080

### Sign In
# @name signIn
POST {{uri}}/api/v1/auth/sign-in
Content-Type: application/json

{
    "account": "jrmarcco@gmail.com",
    "accountType": "email",
    "credential": "<passwd>"
}

# {
#     "account": "test-user-1@example.com",
#     "accountType": "email",
#     "credential": "hermet@2026"
# }


### Refresh Access Token
POST {{uri}}/api/v1/auth/refresh-token
Content-Type: application/json

{
    "refreshToken": "{{signIn.response.body.$.data.refreshToken}}"
}


### Add Contact Application
POST {{uri}}/api/v1/contact/apply
x-access-token: Bearer {{signIn.response.body.$.data.accessToken}}
Content-Type: application/json

{
    "contactId": 134605228232032256,
    "message": "hello hello!!!",
    "source": "search"
}


### Get Contact Applications
GET {{uri}}/api/v1/contact/applications
x-access-token: Bearer {{signIn.response.body.$.data.accessToken}}
Content-Type: application/json


### Review Contact Application
POST {{uri}}/api/v1/contact/review
x-access-token: Bearer {{signIn.response.body.$.data.accessToken}}
Content-Type: application/json

{
    "applicationId": 143667005994565632,
    "status": "approved"
}


### Get Contacts
GET {{uri}}/api/v1/contact/contacts
x-access-token: Bearer {{signIn.response.body.$.data.accessToken}}
Content-Type: application/json


### Create Group
POST {{uri}}/api/v1/group/create
x-access-token: Bearer {{signIn.response.body.$.data.accessToken}}
Content-Type: application/json

{
    "name": "test-group-12",
    "avatar": "",
    "memberIds": [
        134605228232032256,
        143662228415512576,
        143658079553953792,
        143663311559270400,
        143665467381035008,
        143666934888747008
    ]
}


### Get Channels
GET {{uri}}/api/v1/channel/channels
x-access-token: Bearer {{signIn.response.body.$.data.accessToken}}
Content-Type: application/json


