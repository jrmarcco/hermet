# PostgreSQL 分片集群部署变量 ( 复制为 .env 后按需修改; init.sh 会自动生成一份 )。
#
# 注意: 密码修改需要同步三处——
#   1. 这里 ( 数据库实际密码 )
#   2. etc/config.yaml 的 db.sharding DSN
#   3. scripts/docker/debezium/connectors/*.json 的 database.password
POSTGRES_0_PASSWORD=change-me-0
POSTGRES_1_PASSWORD=change-me-1

# 镜像版本 ( 固定 tag 保证可复现部署 )。
POSTGRES_IMAGE=postgres:18.6

# 宿主机端口映射 ( 容器间互访走 jrmarcco_net 内部地址 pgsql-hermet-N:5432 )。
POSTGRES_0_PORT=15432
POSTGRES_1_PORT=25432
