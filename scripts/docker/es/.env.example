# Elasticsearch 部署变量 ( 复制为 .env 后按需修改; init.sh 会自动生成一份 )。
#
# elastic 超级用户密码 ( 随机生成; 需同步至 etc/config.yaml 的 es 段 )。
ELASTIC_PASSWORD=change-me

# 镜像版本 ( 固定 tag 保证可复现部署 )。
ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:9.5.5
KIBANA_IMAGE=docker.elastic.co/kibana/kibana:9.5.5

# 宿主机端口映射。
ELASTICSEARCH_PORT=19200
KIBANA_PORT=15601

# JVM 堆内存 ( 建议 = 容器内存限额的一半 )。
ES_JAVA_OPTS=-Xms1g -Xmx1g
