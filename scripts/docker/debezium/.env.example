# Debezium Connect 集群部署变量 ( 复制为 .env 后按需修改; init.sh 会自动生成一份 )。
#
# Kafka Connect 集群 ID ( 同组内的 3 个 connect 节点组成一个集群 )。
DEBEZIUM_GROUP_ID=debezium-connector-cluster

# Kafka 集群地址 ( 容器间走 INTERNAL listener，与 gateway/scripts/docker/kafka 部署一致 )。
KAFKA_BOOTSTRAP_SERVERS=kafka-1:9093,kafka-2:9093,kafka-3:9093

# TLS 密钥库密码 ( 与 gateway kafka 部署的 KAFKA_TLS_KEY_PASSWORD 同源，
# init.sh 从该部署目录复制客户端证书，密码不一致会导致 TLS 握手失败 )。
KAFKA_TLS_KEY_PASSWORD=kafka-secret

# 镜像版本 ( 固定 tag 保证可复现部署 )。
DEBEZIUM_IMAGE=quay.io/debezium/connect:3.7.0.Final
ALPINE_IMAGE=alpine:3.24

# 宿主机端口映射 ( REST API 管理入口 )。
DEBEZIUM_CONNECT_PORT=8083
